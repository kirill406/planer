# SQLite by default; Postgres: postgresql+asyncpg://user:pass@host:5432/planer
PLANER_DATABASE_URL=sqlite+aiosqlite:///./data/planer.db
# Password for /admin (user "admin"); empty disables the admin page
PLANER_ADMIN_PASSWORD=
PLANER_HOST=127.0.0.1
PLANER_PORT=8000
PLANER_RELOAD=false
PLANER_LOG_LEVEL=INFO
# true = create tables without Alembic (tests, throwaway demos)
PLANER_CREATE_SCHEMA=false
